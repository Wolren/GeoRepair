"""Stubs for the geo_repair extension module.

The full API surface mirrors src/bindings/python.rs. Runtime behavior:
- repair* functions never raise on geometry problems; unparseable batch
  inputs are returned unchanged.
- validate* functions return error strings; collection components are
  prefixed with "[geom N]".
- Parse failures of single-geometry inputs raise ValueError.
"""
from typing import List, Optional, Tuple

__version__: str

def version() -> str: ...

# --- WKB (bytes) ---
def repair_wkb(
    wkb: bytes, method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> bytes: ...
def repair_wkb_batch(
    wkbs: List[bytes], method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> List[bytes]: ...
def par_repair_wkb_batch(
    wkbs: List[bytes], method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> List[bytes]: ...
def repair_validate_wkb(
    wkb: bytes, method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> Tuple[bytes, bool, List[str]]: ...
def repair_validate_wkb_batch(
    wkbs: List[bytes], method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> List[Tuple[bytes, bool, List[str]]]: ...
def is_valid_wkb(wkb: bytes) -> bool: ...
def is_valid_wkb_batch(wkbs: List[bytes]) -> List[bool]: ...
def validate_wkb(wkb: bytes) -> Tuple[bool, List[str]]: ...
def validate_wkb_batch(wkbs: List[bytes]) -> List[Tuple[bool, List[str]]]: ...
def validate_and_fix_wkb(
    wkb: bytes, method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> Tuple[bool, List[str], bytes]: ...
def validate_and_fix_wkb_batch(
    wkbs: List[bytes], method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> List[Tuple[bool, List[str], bytes]]: ...

# --- WKT (text) ---
def repair_wkt(
    wkt: str, method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> str: ...
def repair_wkt_batch(
    wkts: List[str], method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> List[str]: ...
def par_repair_wkt_batch(
    wkts: List[str], method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> List[str]: ...
def repair_validate_wkt(
    wkt: str, method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> Tuple[str, bool, List[str]]: ...
def repair_validate_wkt_batch(
    wkts: List[str], method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> List[Tuple[str, bool, List[str]]]: ...
def is_valid_wkt(wkt: str) -> bool: ...
def is_valid_wkt_batch(wkts: List[str]) -> List[bool]: ...
def validate_wkt(wkt: str) -> List[str]: ...
def validate_wkt_batch(wkts: List[str]) -> List[List[str]]: ...
def validate_and_fix_wkt(
    wkt: str, method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> Tuple[bool, List[str], str]: ...
def validate_and_fix_wkt_batch(
    wkts: List[str], method: Optional[str] = None, keep_collapsed: Optional[bool] = None
) -> List[Tuple[bool, List[str], str]]: ...
